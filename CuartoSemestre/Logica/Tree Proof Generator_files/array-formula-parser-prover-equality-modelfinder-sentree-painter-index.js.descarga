}
SolvedForm.prototype.checkSatisfiable = function() {
return true;
}
SolvedForm.prototype.copy = function() {
var res = new SolvedForm();
for (key in this.solvedDict) {
res.solvedDict[key] = this.solvedDict[key];
}
