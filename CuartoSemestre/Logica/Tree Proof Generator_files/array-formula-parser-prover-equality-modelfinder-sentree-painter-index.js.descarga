var sfa = this.solvedForms[i].addGreater(s,t);
if (sfa.length != 1 || !sfa[0].equals(this.solvedForms[i])) sfChanged = true;
sfs.extendNoDuplicates(sfa);
}
if (sfs.length == 0) {
return null;
}
if (sfChanged) {
var newInequalities = this.inequalities.copy();
newInequalities.push(s+'>'+t);
