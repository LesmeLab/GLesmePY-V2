}
EqualityProblem.prototype.toString = function() {
var nextStepStr = this.nextStep==this.tryRrbs ? 'rrbs' :
this.nextStep==this.tryLrbs ? 'lrbs' :
this.nextStep==this.tryEr ? 'er' :
this.nextStep==this.start ? 'start' :
this.nextStep==null ? '' : '???';
