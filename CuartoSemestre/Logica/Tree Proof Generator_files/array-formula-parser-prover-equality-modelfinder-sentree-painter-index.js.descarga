str = str.substr(args.length);
}
else if (!boundVars.includes(nextTerm)) {
this.registerExpression(nextTerm, 'individual constant', 0);
}
result.push(nextTerm);
if (str.indexOf(",") == 0) str = str.substr(1);
} while (str.length > 0);
