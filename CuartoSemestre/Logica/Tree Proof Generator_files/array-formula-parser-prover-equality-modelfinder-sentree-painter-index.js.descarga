for (var i=0; i<this.inequalities.length; i++) {
var ineq = this.inequalities[i];
var newRes = [];
for (var j=0; j<res.length; j++) {
newRes.extendNoDuplicates(res[j].addGreater(ineq[0],ineq[1]));
}
res = newRes;
}
return res;
