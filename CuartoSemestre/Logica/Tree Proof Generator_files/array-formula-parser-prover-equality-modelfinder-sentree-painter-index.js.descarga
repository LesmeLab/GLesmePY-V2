for (var i=0; i<terms.length; i++) {
if (terms[i].isArray) {
res.extendNoDuplicates(getVariablesInTermList(terms[i]));
}
else if ((terms[i][0] == 'ξ' || terms[i][0] == 'ζ') && !dupe[terms[i]]) {
dupe[terms[i]] = true;
