if (sf.length != 1 || !sf[0].equals(this.solvedForms[i])) sfChanged = true;
sfs.extendNoDuplicates(sf);
}
if (sfs.length == 0) {
return null;
}
if (sfChanged) {
var newEqualities = this.equalities.copy();
newEqualities.push(s+'='+t);
