}
if (term[0] == 'ξ' || term[0] == 'ζ') return [];
if (term[0] == 'ω' || this.parser.expressionType[term] == 'world variable') return [];
return [term];
}
function replaceSubterm(term, sub, repl) {
var subStr = sub.toString();
if (term.toString() == subStr) return [repl];
